# Copy to /etc/cocohealth-contact.env on Linode, not to the public site.
# Use a restricted SMTP account and an approved business inbox.
PORT=3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false requires STARTTLS; true uses implicit TLS (normally port 465).
SMTP_SECURE=false
SMTP_USER=replace-on-server
SMTP_PASS=replace-on-server
CONTACT_FROM=info@cocohealth.co.uk
CONTACT_TO=health@cocohealth.co.uk
